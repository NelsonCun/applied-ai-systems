# Aplicación
PROJECT_NAME=SmartInvoice
ENVIRONMENT=production
API_V1_PREFIX=/api/v1
SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL
POSTGRES_DB=smartinvoice
POSTGRES_USER=smartinvoice_user
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_RANDOM_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://smartinvoice_user:CHANGE_ME_WITH_A_RANDOM_PASSWORD@db:5432/smartinvoice

# Redis y Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Archivos
UPLOAD_DIR=/app/storage/uploads
PROCESSED_DIR=/app/storage/processed
REPORTS_DIR=/app/storage/reports
RPA_EVIDENCE_DIR=/app/storage/rpa
MAX_UPLOAD_SIZE_MB=15

# OCR
TESSERACT_LANGUAGE=spa+eng
OCR_MIN_CONFIDENCE=60
OCR_DPI=300
MAX_PDF_PAGES=5

# SMTP real de producción.
# Gmail requiere una contraseña de aplicación; la contraseña principal no se utiliza.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=CORREO_REMITENTE
SMTP_PASSWORD=CONTRASENA_DE_APLICACION
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=30
SMTP_FROM_EMAIL=CORREO_REMITENTE
SMTP_FROM_NAME=SmartInvoice

# Alternativa exclusiva para desarrollo local:
# SMTP_HOST=mailhog
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=false
# SMTP_FROM_EMAIL=notificaciones@smartinvoice.local

# RPA
RPA_TARGET_URL=http://rpa-target:8080
RPA_USERNAME=robot
RPA_PASSWORD=CHANGE_ME_WITH_A_RANDOM_PASSWORD

# Frontend y CORS
VITE_API_URL=/api/v1
CORS_ORIGINS=http://EC2_PUBLIC_IP

# Usuario de archivos dentro de las imágenes
LOCAL_UID=1000
LOCAL_GID=1000
