# Aplicación
PROJECT_NAME=SmartInvoice
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-secure-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL
POSTGRES_DB=smartinvoice
POSTGRES_USER=smartinvoice_user
POSTGRES_PASSWORD=smartinvoice_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://smartinvoice_user:smartinvoice_password@db:5432/smartinvoice

# Redis y Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Archivos
UPLOAD_DIR=/app/storage/uploads
PROCESSED_DIR=/app/storage/processed
REPORTS_DIR=/app/storage/reports
RPA_EVIDENCE_DIR=/app/storage/rpa
MAX_UPLOAD_SIZE_MB=15

# OCR
TESSERACT_LANGUAGE=spa
OCR_MIN_CONFIDENCE=60
OCR_DPI=300

# Correo local con MailHog
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=smartinvoice@localhost

# RPA
RPA_TARGET_URL=http://rpa-target:8080
RPA_USERNAME=robot
RPA_PASSWORD=robot123

# Frontend
VITE_API_URL=http://localhost:8001/api/v1

# CORS
CORS_ORIGINS=http://localhost:5174,http://localhost:8080
JWT_ALGORITHM=HS256
MAX_PDF_PAGES=5
LOCAL_UID=1000
LOCAL_GID=1000
SMTP_TIMEOUT_SECONDS=30
SMTP_FROM_EMAIL=notificaciones@smartinvoice.com
SMTP_FROM_NAME=SmartInvoice
